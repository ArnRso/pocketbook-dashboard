{% set best = data.best %}
<div class="widget commute">
    <div class="tile-title">{{ data.origin }} → {{ data.destination }}</div>
    <div class="commute-body">
        <div class="commute-duration">{{ best.minutes|round }}<small> min</small></div>
        <div class="commute-info">
            <div class="status {{ best.status.value }}">
                {{ best.status.label }}{% if best.delay >= 1 %} · +{{ best.delay|round }} min{% endif %}
            </div>
            <div>Arrivée vers <b>{{ data.arrival|date('H:i') }}</b></div>
            <div class="commute-route">{{ best.kilometers|number_format(1, ',') }} km par {{ best.name }}</div>
        </div>
    </div>
</div>
