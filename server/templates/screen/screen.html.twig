{% set font = 'fonts/AtkinsonHyperlegibleNext.ttf' %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ dashboard ? dashboard.name : 'Dashboard' }}</title>
    <style>
        @font-face {
            font-family: "Atkinson";
            src: url("{{ gotenberg ? gotenberg_asset(font) : asset(font) }}");
            font-weight: 200 800;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            width: {{ screen.width }}px;
            height: {{ screen.height }}px;
            overflow: hidden;
            background: #fff;
            color: #000;
        }

        body {
            font-family: "Atkinson", sans-serif;
            font-size: 32px;
            line-height: 1.2;
        }

        .muted { color: #444; }
        .icon { display: block; width: 100%; height: 100%; }

        /* Grille : chaque tuile est un conteneur, ses widgets se dimensionnent en proportion (cqw, cqh) */
        .grid {
            display: grid;
            width: 100%;
            height: 100%;
            padding: 10px;
            grid-template-columns: repeat({{ constant('App\\Screen\\Grid::COLUMNS') }}, minmax(0, 1fr));
            grid-template-rows: repeat({{ constant('App\\Screen\\Grid::ROWS') }}, minmax(0, 1fr));
        }

        /* Mise en page automatique : chaque ligne prend sa part de la hauteur (flex-grow) ; si les parts
           totalisent moins de 1, le reste de l'écran reste libre */
        .lines { display: flex; flex-direction: column; width: 100%; height: 100%; padding: 10px; }
        .line { display: flex; flex: 1 1 0; min-height: 0; }
        .line > .tile { flex: 1 1 0; min-width: 0; }

        .tile {
            container-type: size;
            margin: 8px;
            padding: 16px 22px;
            overflow: hidden;
            border: 3px solid #000;
            border-radius: 16px;
        }

        .widget { display: flex; flex-direction: column; width: 100%; height: 100%; }

        .tile-title {
            margin-bottom: 2cqh;
            overflow: hidden;
            font-size: clamp(18px, 10cqh, 30px);
            font-weight: 800;
            letter-spacing: .1em;
            text-overflow: ellipsis;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .notice { font-size: clamp(20px, 12cqh, 40px); font-weight: 700; }

        .empty {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            padding: 80px;
            font-size: 48px;
            font-weight: 700;
            text-align: center;
        }

        /* Date et heure */
        .clock { justify-content: center; }
        .clock-date { overflow: hidden; font-size: min(48cqh, 7.5cqw); font-weight: 800; line-height: 1; white-space: nowrap; }
        .clock-meta { margin-top: 4cqh; font-size: min(20cqh, 3.2cqw); }

        /* Météo actuelle */
        .current { flex-direction: row; align-items: center; gap: 3cqw; }
        .current .icon { flex: none; width: min(90cqh, 30cqw); height: min(90cqh, 30cqw); }
        .current-temp { font-size: min(80cqh, 24cqw); font-weight: 800; line-height: .85; letter-spacing: -.04em; }
        .current-details { margin-left: auto; font-size: min(11cqh, 2.8cqw); line-height: 1.4; text-align: right; }
        .current-condition { font-size: 1.35em; font-weight: 800; }
        @container (max-width: 760px) { .current-details { display: none; } }

        /* Pluie */
        .rain-body { display: flex; flex: 1; align-items: flex-end; justify-content: space-between; gap: 3cqw; }
        .rain-summary { font-size: min(34cqh, 4.6cqw); font-weight: 800; }
        .rain-totals { font-size: min(18cqh, 2.8cqw); line-height: 1.4; text-align: right; }
        @container (max-width: 760px) {
            .rain-body { flex-direction: column; align-items: flex-start; justify-content: center; }
            .rain-summary { font-size: 8cqw; }
            .rain-totals { font-size: 5cqw; text-align: left; }
        }

        /* Prévisions heure par heure : autant d'heures que la largeur en permet */
        .hours {
            display: grid;
            height: 100%;
            overflow: hidden;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            grid-template-rows: 100%;
            grid-auto-rows: 0;
            text-align: center;
        }
        .hour { display: flex; flex-direction: column; align-items: center; min-height: 0; }
        .hour-label { font-size: min(9cqh, 30px); font-weight: 700; }
        .hour .icon { flex: none; width: min(18cqh, 72px); height: min(18cqh, 72px); margin: 1cqh 0; }
        .hour-temp { font-size: min(10cqh, 38px); font-weight: 800; }
        .bar-area { position: relative; flex: 1; width: 100%; min-height: 0; margin-top: 1cqh; border-bottom: 4px solid #000; }
        .bar { position: absolute; bottom: 0; left: 20%; width: 60%; background: #000; }
        .hour-mm { margin-top: .5cqh; font-size: min(7cqh, 28px); font-weight: 700; }
        .hour-prob { font-size: min(7cqh, 26px); }
        @container (max-height: 300px) { .bar-area, .hour-mm, .hour-prob { display: none; } }

        /* Trajet */
        .commute-body { display: flex; flex: 1; align-items: center; gap: 4cqw; min-height: 0; }
        .commute-duration { font-size: min(55cqh, 22cqw); font-weight: 800; line-height: .9; letter-spacing: -.04em; white-space: nowrap; }
        .commute-duration small { font-size: .3em; letter-spacing: 0; }
        .commute-info { font-size: min(11cqh, 3cqw); line-height: 1.45; }
        .status {
            display: inline-block;
            margin-bottom: .3em;
            padding: .1em .5em;
            border: 4px solid #000;
            border-radius: 12px;
            font-size: 1.15em;
            font-weight: 800;
        }
        .status.slow { background: #bbb; }
        .status.jammed { background: #000; color: #fff; }
        @container (max-width: 760px) { .commute-route { display: none; } }

        /* Pont Chaban-Delmas */
        .chaban-ongoing {
            align-self: flex-start;
            margin-bottom: 1.5cqh;
            padding: .1em .5em;
            border-radius: 12px;
            background: #000;
            color: #fff;
            font-size: clamp(22px, 12cqh, 44px);
            font-weight: 800;
        }
        .chaban-closures { list-style: none; overflow: hidden; font-size: clamp(18px, min(10cqh, 5.5cqw), 38px); }
        .chaban-closures li { display: flex; gap: 1em; padding: .2em 0; border-top: 2px solid #888; white-space: nowrap; }
        .chaban-day { flex: none; width: 7em; }
        .chaban-reason { overflow: hidden; text-overflow: ellipsis; }
        @container (max-width: 600px) {
            .chaban-closures li { flex-wrap: wrap; gap: 0 .6em; }
            .chaban-day { width: auto; }
            .chaban-reason { display: none; }
        }

        /* Rappels */
        .reminder-list { list-style: none; overflow: hidden; font-size: clamp(22px, min(26cqh, 6cqw), 56px); }
        .reminder-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 .6em; padding: .1em 0; }
        .reminder-list li + li { border-top: 2px solid #888; }
        .reminder-text { font-weight: 800; }
        .reminder-until { font-size: .6em; }
    </style>
</head>
<body>
    {% if dashboard and dashboard.layout == constant('App\\Entity\\DashboardLayout::Auto') %}
        <div class="lines">
            {% for row in rows %}
                <div class="line" style="flex-grow: {{ row.share|round(4) }}">
                    {% for rendered in row.tiles %}
                        <div class="tile tile-{{ rendered.tile.widget }}">
                            {{ rendered.html|raw }}
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    {% elseif dashboard %}
        <div class="grid">
            {% for rendered in tiles %}
                {% set tile = rendered.tile %}
                <div class="tile tile-{{ tile.widget }}" style="grid-column: {{ tile.column }} / span {{ tile.width }}; grid-row: {{ tile.row }} / span {{ tile.height }}">
                    {{ rendered.html|raw }}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty">Aucun dashboard n'est assigné à cette liseuse.<br>Choisissez-en un dans l'admin, rubrique Liseuses.</div>
    {% endif %}
</body>
</html>
